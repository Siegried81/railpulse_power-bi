	column 'Day Label'
		lineageTag: 95eaa51e-c263-4aef-87b7-b4a9f19c64b5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day Label]

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				
				VAR MinDate = MIN(liveboard_records[scheduled_time])
				VAR MaxDate = MAX(liveboard_records[scheduled_time])
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "MonthNum", YEAR([Date]) * 100 + MONTH([Date]),
				    "Month", FORMAT([Date], "MMM YYYY"),
				    "Week", WEEKNUM([Date], 2),
				    "Week Label", "W" & WEEKNUM([Date], 2) & " " & YEAR([Date]),
				    "Day Label", FORMAT([Date], "ddd dd/MM")
				)

	annotation PBI_Id = 0ac12345e4df4acd86653b85bfac0bac

